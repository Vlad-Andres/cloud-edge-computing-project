          "expr": "rate(pg_stat_database_blks_hit{datname=\"$datname\"}[1m]) / (rate(pg_stat_database_blks_hit{datname=\"$datname\"}[1m]) + rate(pg_stat_database_blks_read{datname=\"$datname\"}[1m]))",
