{
  "title": "Store consumer",
  "schemaVersion": 39,
  "version": 5,
  "panels": [
    {
      "type": "timeseries",
      "title": "Database request rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(store_db_requests_total[1m])) > 0.001",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database request latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(store_db_request_duration_seconds_bucket[5m]))) and on (operation) (sum by (operation) (rate(store_db_requests_total[1m])) > 0.001)",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Database errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(store_db_errors_total[1m])) > 0.001",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"groupdb\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer event load (events/sec)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (job) (rate(kafka_messages_consumed_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "description": "All decoded Kafka events per second for each consumer."
    },
    {
      "type": "timeseries",
      "title": "Event types received (events/sec)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (job, event_type) (rate(kafka_events_consumed_total[1m]))",
          "legendFormat": "{{job}} — {{event_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "description": "Decoded Kafka event rate grouped by event type and consumer."
    },
    {
      "type": "timeseries",
      "title": "Kafka decode errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (job) (rate(kafka_decode_errors_total[1m])) > 0.001",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "type": "timeseries",
      "title": "Notification service latency (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job, notification_type) (rate(notify_service_latency_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{notification_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
